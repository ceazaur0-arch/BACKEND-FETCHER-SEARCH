# Put these in Render > your service > Environment. Never commit real values.

# --- required ---
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require   # Neon or Supabase (pooled URL)
DASHBOARD_TOKEN=replace-with-a-long-random-signing-secret     # server only; never enter in frontend
ADMIN_EMAIL=admin@example.com                                  # administrator sign-in email
ADMIN_PASSWORD=replace-with-a-strong-unique-password           # server only; never commit real value
CRON_KEY=choose-another-long-secret                             # used in the tick URL
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash   # change if Google retires this model name

# --- telegram bot (alerts + share-to-bot) ---
TG_BOT_TOKEN=
TG_WEBHOOK_SECRET=choose-a-random-string
TG_OWNER_ID=        # fill after step 6 of the README

# --- X official API ---
X_BEARER_TOKEN=     # leave empty if you have no X API credit: X search is skipped, share-to-bot still works
# X_BURST=20  X_WINDOW=60  X_REST=600      # 20 searches/minute, then 10 minute rest
# X_DAILY_READS=300                         # hard cap on posts read per day (cost control)

# --- optional extra sources ---
# NEYNAR_API_KEY=                           # Farcaster
# REDDIT_CLIENT_ID=  REDDIT_CLIENT_SECRET=  REDDIT_SUBS=solana
# TG_API_ID=  TG_API_HASH=  TG_SESSION=  TG_CHANNELS=channel1,channel2

# --- after the frontend is live ---
# FRONTEND_ORIGIN=https://your-project.vercel.app
